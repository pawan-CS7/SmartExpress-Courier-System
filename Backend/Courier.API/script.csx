using Courier.API.Entities; using Microsoft.EntityFrameworkCore; var options = new DbContextOptionsBuilder<Courier.API.AppDbContext>().UseSqlServer("Server=(localdb)\\MSSQLLocalDB;Database=CourierDb;Trusted_Connection=True;TrustServerCertificate=True;").Options; using var context = new Courier.API.AppDbContext(options); var u = context.Users.FirstOrDefault(u => u.Name.Contains("sorting")); Console.WriteLine(u.Name + " - " + u.Role);
